# Set NODE_ENV=production on the server so CORS localhost defaults are ignored
# and the app behaves as production. TRUST_PROXY must be true there because Nginx
# terminates TLS and the rate limiter / req.ip rely on X-Forwarded-For.
NODE_ENV=development
PORT=5001
MONGO_URI=your_mongodb_connection_string
JWT_SECRET=anylongrandomstring
GOOGLE_CLIENT_ID=from_google_console
GOOGLE_CLIENT_SECRET=from_google_console
# Production: GOOGLE_CALLBACK_URL=https://api.yourdomain.com/api/auth/google/callback
#   and register that exact URI as an authorized redirect in Google Cloud Console.
GOOGLE_CALLBACK_URL=http://localhost:5001/api/auth/google/callback
CLIENT_URL=http://localhost:5173
TRUST_PROXY=

# CORS / CSRF: comma-separated origins allowed to call the API from a browser.
# Always include your frontend origin(s), e.g. https://yourapp.vercel.app
CORS_ORIGINS=

# Real email: generate a 16-character Google App Password, then set SMTP_PASS.
# Leave empty to keep the local email simulator.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=
SMTP_FROM="Zeltxx Platform <your_email@gmail.com>"